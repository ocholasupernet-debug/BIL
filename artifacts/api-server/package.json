{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development PORT=8080 && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "tsx --test src/**/*.test.ts",
    "test:router-script": "tsx --test tests/router-script-generation.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:migration": "node --test tests/router-migration.test.mjs tests/prepaid-transaction-account-claim.test.mjs tests/mpesa-checkout-idempotency.test.mjs",
    "test:tenant-vouchers": "node --test tests/tenant-vouchers.test.mjs",
    "test:vpn-fallback": "node --test tests/router-vpn-fallback.test.mjs",
    "test:pppoe-portal": "node --test tests/pppoe-portal-reference.test.mjs",
    "test:pppoe-portal-live": "node --test tests/pppoe-portal-live-staging.test.mjs",
    "test:pppoe-renewal": "tsx --test tests/pppoe-renewal-staging.test.mjs",
    "test:hotspot-export": "node --test tests/hotspot-export.test.mjs tests/hotspot-saved-device-manager.test.mjs tests/hotspot-portal-resilience.test.mjs",
    "test:hotspot-router-staging": "tsx --test tests/hotspot-router-staging.test.ts",
    "test:hotspot-portal-live": "tsx --test tests/hotspot-router-staging.test.ts",
    "test:hotspot-portal-deploy": "tsx --test src/lib/hotspot-portal-deploy.test.ts",
    "test:payment-routing": "node --test tests/payment-routing.test.mjs",
    "test:platform-income": "node --test tests/platform-income-reporting.test.mjs && tsx --test src/routes/super-admin-billing-route.test.ts",
    "test:account-policy": "node --test tests/account-safety-password-policy.test.mjs",
    "test:storage-governance": "node --test tests/storage-governance.test.mjs",
    "test:whatsapp": "tsx --test src/services/whatsapp/whatsapp-service.test.ts && node --test tests/whatsapp-integration.test.mjs",
    "test:sms": "tsx --test src/services/sms/sms-service.test.ts && node --test tests/sms-integration.test.mjs"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.18.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "node-routeros": "^1.6.9",
    "nodemailer": "^10.0.11",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
