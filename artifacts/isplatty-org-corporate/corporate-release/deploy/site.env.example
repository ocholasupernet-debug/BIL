# TEMPLATE ONLY. Create /etc/isplatty-org/site.env privately; never commit it.
NODE_ENV=production
HOST=127.0.0.1
# Example only: verify this port is unused. NEVER choose BIL's port 8080.
PORT=8091
BASE_PATH=/
ISPLATTY_ORG_PUBLIC_ORIGIN=https://isplatty.org
ISPLATTY_ORG_TRUST_LOOPBACK=true
# Dedicated role/database. Fill credentials privately, never copy BIL credentials.
ISPLATTY_ORG_DATABASE_URL=
ISPLATTY_ORG_BOOTSTRAP_PASSWORD=
ISPLATTY_ORG_UPLOAD_DIR=/var/www/isplatty-org/shared/uploads
