##############################################################
# OcholaSupernet — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
##############################################################

# ── API Server ────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Supabase (primary data store) ─────────────────────────
# REST API URL — format: https://xxx.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
# Anon (public) key — safe to expose in browser
VITE_SUPABASE_KEY=your-supabase-anon-key
# Service role key — bypasses RLS, server-side only, keep secret!
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key  ← store as Replit Secret
# Optional direct Postgres connection string used by deploy/deploy.sh to apply
# Supabase migrations. Keep this server-side; REST credentials cannot run DDL.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Safaricom Daraja / M-Pesa ───────────────────────────────
# The API encrypts these values before it saves them to Supabase.
# Use them only to bootstrap the initial encrypted record, and always set them
# as Replit Secrets — never commit them to this file.
# MPESA_CONSUMER_KEY=your-daraja-consumer-key
# MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
# MPESA_PASSKEY=your-lipa-na-mpesa-passkey
# MPESA_SHORTCODE=your-business-shortcode
# MPESA_ENV=production
# MPESA_CALLBACK_URL=https://your-public-domain.example/api/mpesa/callback
# SESSION_SECRET=server-only-secret-used-to-encrypt-daraja-settings
# SUPERADMIN_PASSWORD=passcode-required-to-change-daraja-settings

# ── MikroTik Default Router ───────────────────────────────
# Used by GET /api/router/env/live (single "default" router).
# Multi-router setups store credentials per-router in Supabase isp_routers.
#
# ⚠ REMOTE CONNECTION REQUIREMENTS:
#   - MIKROTIK_HOST must be the router's PUBLIC IP (not 192.168.x.x)
#   - Port 8728 (plain API) or 8729 (API-SSL, preferred for internet)
#   - VPS IP must be allowed in the router firewall (download firewall script
#     from GET /api/router/:id/firewall-script?vpsIp=<your-vps-ip>)
#   - If behind NAT with no public IP, use VPN tunnel (see MIKROTIK_BRIDGE_IP)
#
MIKROTIK_HOST=your-router-public-ip-or-hostname

# IMPORTANT: store MIKROTIK_PASSWORD as a Secret, never commit it here.
# MIKROTIK_PASSWORD=your-router-api-password      ← store as Replit Secret

# OPTIONAL — defaults shown:
# MIKROTIK_USERNAME=admin         # API user on the router (not the web UI user)
# MIKROTIK_PORT=8728              # 8728 = plain, 8729 = API-SSL
# MIKROTIK_USE_SSL=false          # "true" to force encrypted API-SSL (port 8729)
# MIKROTIK_TLS_VERIFY=false       # "true" if router has a valid signed certificate

# ── VPN Tunnel Fallback ────────────────────────────────────
# If the router has no public IP, connect through a VPN tunnel.
# Set MIKROTIK_BRIDGE_IP to the IP the router gets inside the VPN.
# The backend will automatically try MIKROTIK_HOST first, then BRIDGE_IP.
# MIKROTIK_BRIDGE_IP=10.8.0.2    # VPN tunnel IP of the router (e.g., OpenVPN)
#
# Router-management fallback order is OpenVPN → WireGuard → IPsec.
# OpenVPN uses the VPS endpoint and ROUTER_OPENVPN_PORT (default 1196).
# ROUTER_OPENVPN_ENDPOINT is preferred; VPS_HOST is accepted as a fallback.
# In production the installer is withheld until the dedicated VPS control
# plane is ready. If the API is hosted separately from the VPS, set the
# readiness flag only after the VPS setup script has completed successfully.
# WireGuard is attempted only on RouterOS 7+ and is enabled only when all
# three server-side values are present. The client private key is delivered
# only inside the authenticated router script; it is never sent to the browser.
# ROUTER_OPENVPN_PORT=1196
# ROUTER_OPENVPN_ENDPOINT=vpn.example.com
# ROUTER_OPENVPN_SERVER_READY=true
# ROUTER_OPENVPN_CHECK_FILESYSTEM=true
# ROUTER_WIREGUARD_ENDPOINT=vpn.example.com
# ROUTER_WIREGUARD_PORT=51820
# ROUTER_WIREGUARD_SERVER_PUBLIC_KEY=base64-server-public-key
# ROUTER_WIREGUARD_CLIENT_PRIVATE_KEY=base64-router-private-key
# Set true only after the matching VPS peer and routes are provisioned.
# ROUTER_WIREGUARD_SERVER_READY=true
# For per-router material, append the numeric router id to each variable name,
# e.g. ROUTER_WIREGUARD_CLIENT_PRIVATE_KEY_42 and
# ROUTER_WIREGUARD_SERVER_READY_42. The suffixed value wins.
#
# IPsec is the final fallback. Its peer/identity/policy resources are verified
# by the router script; the authenticated heartbeat confirms reachability.
# ROUTER_IPSEC_ENDPOINT=vpn.example.com
# ROUTER_IPSEC_PSK=server-side-pre-shared-key
# ROUTER_IPSEC_SERVER_READY=true

# ── Connection Tuning ──────────────────────────────────────
# MIKROTIK_CONNECT_TIMEOUT=15000  # ms to wait for TCP connect (default: 15000)
# MIKROTIK_REQUEST_TIMEOUT=20000  # ms to wait for API response (default: 20000)
# MIKROTIK_MAX_RETRIES=2          # how many times to retry failed connections

# ── Frontend ───────────────────────────────────────────────
# BASE_PATH should stay "/" for VPS root hosting
BASE_PATH=/
